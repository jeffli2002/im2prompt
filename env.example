# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Analytics
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Cloudinary (for prompt library images)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name" 

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/database"

# Auth
BETTER_AUTH_SECRET="your-secret-key"

# OAuth Providers
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
RESEND_API_KEY="your-resend-api-key"
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# R2 Storage
R2_BUCKET_NAME="your-bucket-name"
R2_ACCESS_KEY_ID="your-access-key-id"
R2_SECRET_ACCESS_KEY="your-secret-access-key"
R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
R2_PUBLIC_URL="https://your-domain.com"

# Stripe Payment
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY="price_xxx"
NEXT_PUBLIC_STRIPE_PRICE_PRO_YEARLY="price_xxx"
NEXT_PUBLIC_STRIPE_PRICE_ENTERPRISE_MONTHLY="price_xxx"
NEXT_PUBLIC_STRIPE_PRICE_ENTERPRISE_YEARLY="price_xxx"

# Creem Payment (Alternative to Stripe)
# For Development/Preview: Use test mode credentials
# For Production: Use live mode credentials
CREEM_API_KEY="creem_test_xxx"  # Use creem_live_xxx in production
CREEM_WEBHOOK_SECRET="whsec_test_xxx"  # Use whsec_live_xxx in production
CREEM_PRO_PLAN_PRODUCT_KEY_MONTHLY="prod_xxx"
CREEM_PROPLUS_PLAN_PRODUCT_KEY_MONTHLY="prod_xxx"
CREEM_PRO_PLAN_PRODUCT_KEY_YEARLY="prod_xxx"
CREEM_PROPLUS_PLAN_PRODUCT_KEY_YEARLY="prod_xxx"

# IMPORTANT: Set to "false" ONLY in production, "true" for dev/preview
NEXT_PUBLIC_CREEM_TEST_MODE="true"

NEXT_PUBLIC_CREEM_PRICE_PRO_MONTHLY="price_xxx"
NEXT_PUBLIC_CREEM_PRICE_PRO_YEARLY="price_xxx"
NEXT_PUBLIC_CREEM_PRICE_PROPLUS_MONTHLY="price_xxx"
NEXT_PUBLIC_CREEM_PRICE_PROPLUS_YEARLY="price_xxx"

# Admin Configuration
# Comma-separated list of admin emails
ADMIN_EMAILS="admin@example.com,admin2@example.com"

# Cron Security
# Secret key for cron job authentication (optional but recommended for production)
CRON_SECRET="your-cron-secret-key"

# Coze API (Required for Image-to-Prompt feature)
COZE_API_KEY="your-coze-api-key"
COZE_WORKFLOW_ID="7550263539588399142"

# KIE API (Required for Image-to-Video feature - Sora 2)
KIE_API_KEY="your-kie-api-key"

# Cloudinary (Required for image uploads and content history)
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_UPLOAD_PRESET="your-upload-preset"
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# Content Sharing & History System (Optional - defaults provided)
# These are managed in the system_config table and can be changed via admin panel
# PUBLIC_SHARE_REWARD_CREDITS=3
# MAX_DAILY_SHARE_REWARDS=5
# FREE_TIER_RETENTION_DAYS=3
# PRO_TIER_RETENTION_DAYS=7
# PROPLUS_TIER_RETENTION_DAYS=30

# Monitoring & Alerts (Optional but HIGHLY RECOMMENDED for production)
# SLACK_WEBHOOK_URL="https://hooks.slack.com/services/YOUR/WEBHOOK/URL"
# SENTRY_DSN="https://xxx@sentry.io/xxx"
