setup_creem_billing() {
    log_info "Setting up Creem billing integration..."
    
    # Create Creem provider directory structure
    mkdir -p src/payment/creem
    
    # Check if we need to migrate from Stripe
    if [ -d "src/payment/stripe" ]; then
        log_warning "Stripe integration detected. Migration to Creem required."
        log_info "Creating Creem provider implementation..."
        
        # Create Creem client
        cat > src/payment/creem/client.ts << 'EOF'
import { env } from '@/env';
import { paymentConfig } from '../../config/payment.config';

// Creem configuration
export const creemConfig = {
  apiKey: paymentConfig.creem.apiKey,
  webhookSecret: paymentConfig.creem.webhookSecret,
  environment: paymentConfig.creem.environment,
  baseUrl: paymentConfig.creem.environment === 'production' 
    ? 'https://api.creem.com' 
    : 'https://api.sandbox.creem.com',
};

// Creem API client
export class CreemClient {
  private baseUrl: string;
  private apiKey: string;

  constructor() {
    this.baseUrl = creemConfig.baseUrl;
    this.apiKey = creemConfig.apiKey;
  }

  private async request(endpoint: string, options: RequestInit = {}) {
    const url = `${this.baseUrl}${endpoint}`;
    const response = await fetch(url, {
      ...options,
      headers: {
        'Authorization': `Bearer ${this.apiKey}`,
        'Content-Type': 'application/json',
        ...options.headers,
      },
    });

    if (!response.ok) {
      throw new Error(`Creem API error: ${response.status} ${response.statusText}`);
    }

    return response.json();
  }

  async createCustomer(data: { email: string; name?: string; metadata?: Record<string, any> }) {
    return this.request('/customers', {
      method: 'POST',
      body: JSON.stringify(data),
    });
  }

  async createSubscription(data: {
    customerId: string;
    priceId: string;
    metadata?: Record<string, any>;
  }) {
    return this.request('/subscriptions', {
      method: 'POST',
      body: JSON.stringify(data),
    });
  }

  async createUsageRecord(data: {
    subscriptionId: string;
    quantity: number;
    timestamp?: number;
    action?: 'increment' | 'set';
  }) {
    return this.request('/usage-records', {
      method: 'POST',
      body: JSON.stringify(data),
    });
  }

  async getSubscription(subscriptionId: string) {
    return this.request(`/subscriptions/${subscriptionId}`);
  }

  async cancelSubscription(subscriptionId: string) {
    return this.request(`/subscriptions/${subscriptionId}/cancel`, {
      method: 'POST',
    });
  }
}

export const creem = new CreemClient();
EOF
        
        log_success "Created Creem client implementation"
        
